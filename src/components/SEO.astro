---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: string;
}

const {
  title,
  description = "Handaru Daniswara (daniswastaken) - Software Engineer and Researcher. Explore my portfolio, projects, and perspectives.",
  image = "/og-image.png",
  canonicalUrl = Astro.url.href,
  type = "website",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://handaru.dev/';
const ogImage = new URL(image, siteUrl).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Handaru Daniswara Al Fatih",
  "alternateName": ["Handaru", "Danis", "Handaru Daniswara", "daniswastaken", "Danis Handaru"],
  "url": siteUrl,
  "jobTitle": "Software Engineer & Researcher",
  "sameAs": [
    "https://github.com/daniswastaken"
  ]
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
